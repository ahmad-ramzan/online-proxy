# =============================================================================
# ProxyGPT Online — Environment Variables
# Copy this file to .env (or .env.local) and adjust as needed. All values are
# OPTIONAL — the app runs out of the box without them.
# =============================================================================

# PORT: Port the Node server listens on (default 3000).
PORT="3000"

# NODE_ENV: "production" on the VPS (npm start sets this for you), unset for dev.
# NODE_ENV="production"

# APP_URL: Public base URL of the deployment, e.g. https://proxygpt.yourdomain.com
# Only used to build Stripe success/cancel redirect URLs when the real Stripe
# checkout block is enabled in server/paymentService.ts (checkout is simulated
# by default).
APP_URL="http://localhost:3000"

# DB_DIR: Optional. Directory for the JSON database file (db.json).
# Defaults to ./data inside the project. Set this to store data elsewhere
# (e.g. /var/lib/proxygpt) so it survives redeploys.
# DB_DIR="/var/lib/proxygpt"

# -----------------------------------------------------------------------------
# NOT set here — provider/API keys are configured at RUNTIME via the Admin panel
# (stored in the JSON DB), not through env vars:
#   • Proxy-Seller Residential API key  (Admin → API Settings → Personal API Key)
#   • Stripe / PayPal / Crypto keys      (Admin → Payment Settings)
# -----------------------------------------------------------------------------
