# ProxyGPT Online - Environment Configuration Template
# Copy this file to .env.local (development) or .env.production (production)
# Update with your actual values

# ============================================
# APPLICATION SETTINGS
# ============================================
VITE_APP_NAME=ProxyGPT Online
APP_URL=https://yourdomain.com
PORT=3000
NODE_ENV=production

# ============================================
# PAYMENT GATEWAYS
# ============================================

# Stripe (Recommended for USD payments)
STRIPE_PUBLIC_KEY=pk_live_your_stripe_public_key
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret

# Cryptomus (Cryptocurrency payments)
CRYPTOMUS_MERCHANT_ID=your_cryptomus_merchant_id
CRYPTOMUS_API_KEY=your_cryptomus_api_key
CRYPTOMUS_BASE_URL=https://api.cryptomus.com

# ZiniPay (Bangladesh - bKash/Nagad/card)
ZINIPAY_API_KEY=your_zinipay_api_key
ZINIPAY_BASE_URL=https://api.zinipay.com
ZINIPAY_USD_TO_BDT=108.50
ZINIPAY_ENABLED=true

# PayStation (Bangladesh - Rocket/Nagad/bKash)
PAYSTATION_MERCHANT_ID=your_paystation_merchant_id
PAYSTATION_PASSWORD=your_paystation_password
PAYSTATION_BASE_URL=https://api.paystation.com.bd
PAYSTATION_USD_TO_BDT=108.50

# ============================================
# PROXY PROVIDERS
# ============================================

# Proxy-Seller (Residential Proxies)
PROXY_PROVIDER_URL=https://api.proxy-seller.com
PROXY_PROVIDER_API_KEY=your_proxy_seller_api_key
RESIDENTIAL_API_URL=https://api.proxy-seller.com/api/v1
RESIDENTIAL_API_KEY=your_residential_api_key
RESELLER_UID=your_reseller_uid

# LTESocks (Mobile/5G Proxies)
LTESOCKS_API_KEY=Bearer your_ltesocks_api_token
LTESOCKS_BASE_URL=https://api.ltesocks.io/v2
LTESOCKS_PRICE_DIVISOR=100
LTESOCKS_COUNTRIES=US,GB,DE,FR,CA
LTESOCKS_PRICES=7:4.10,15:8.15,30:15.75
LTESOCKS_MAX_SPEED=200
LTESOCKS_AVAILABLE_PLANS=unlimited_5g,unlimited_4g,50gb_5g
LTESOCKS_STOCK=100

# ============================================
# DATABASE
# ============================================
DATABASE_PATH=/opt/online-proxy/data/db.json

# ============================================
# WEBHOOK SETTINGS
# ============================================
WEBHOOK_SECRET=your_webhook_secret_for_payment_callbacks

# ============================================
# GOOGLE OAUTH (OPTIONAL)
# ============================================
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# ============================================
# WEBSITE CUSTOMIZATION
# ============================================
SITE_NAME=ProxyGPT Online
SITE_DESCRIPTION=Residential and Mobile Proxies for Web Scraping and Data Collection
SUPPORT_EMAIL=support@yourdomain.com
ENABLE_GOOGLE_AUTH=true
MAINTENANCE_MODE=false
GOOGLE_TUTORIAL_VIDEO_URL=https://www.youtube.com/embed/...
PINNED_COUNTRIES=US,GB,DE

# ============================================
# DEVELOPMENT ONLY
# ============================================
# Set these only in development environment
DEBUG=false
LOG_LEVEL=info
